     index_buffer: wgpu::Buffer,
     materials_buffer: wgpu::Buffer,
     geometry_bytes: u64,
+    mutable_opaque: bool,
+}
+
+// Encoding never publishes a new frame identity. A complete command submission
+// may replace cached buffer contents; subsequent readback/present failures must
+// invalidate that identity so a retry cannot mistake partial GPU work for a hit.
+struct FrameBufferSubmission {
+    cache: Arc<Mutex<Option<FrameGpuBuffers>>>,
+    candidate: Option<FrameGpuBuffers>,
+    submitted: bool,
+    accepted: bool,
+}
+
+impl FrameBufferSubmission {
+    fn submitted(&mut self) {
+        *self.cache.lock().unwrap() = self.candidate.take();
+        self.submitted = true;
+    }
+
+    fn accept(&mut self) { self.accepted = true; }
+}
+
+impl Drop for FrameBufferSubmission {
+    fn drop(&mut self) {
+        if self.submitted && !self.accepted {
+            if let Ok(mut cache) = self.cache.lock() { *cache = None; }
+        }
+    }
 }
 
