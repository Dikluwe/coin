+/* Emit a point without a dynamic vertex-array lookup.  On radeonsi, the
+ * dynamic-array point variant does not preserve the emitted positions. */
+static void
+st_emit_clip_point(nir_builder *b, nir_def **v, bool tex0, bool fogc,
+                   bool psize, unsigned n0, unsigned n1)
+{
+   nir_store_output(b, v[ST_CLIP_POS], nir_imm_int(b, 0),
+                    .io_semantics.location = VARYING_SLOT_POS);
+   nir_store_output(b, v[ST_CLIP_COL0], nir_imm_int(b, 0),
+                    .io_semantics.location = VARYING_SLOT_COL0);
+   if (tex0)
+      nir_store_output(b, v[ST_CLIP_TEX0], nir_imm_int(b, 0),
+                       .io_semantics.location = VARYING_SLOT_TEX0);
+   if (fogc)
+      nir_store_output(b, nir_channel(b, v[ST_CLIP_FOGC], 0), nir_imm_int(b, 0),
+                       .io_semantics.location = VARYING_SLOT_FOGC);
+   if (psize)
+      nir_store_output(b, nir_channel(b, v[ST_CLIP_PSIZ], 0), nir_imm_int(b, 0),
+                       .io_semantics.location = VARYING_SLOT_PSIZ);
+   nir_store_output(b, nir_imm_vec4(b, 1, 1, 1, 1), nir_imm_int(b, 0),
+                    .write_mask = (1u << n0) - 1,
+                    .io_semantics.location = VARYING_SLOT_CLIP_DIST0);
+   if (n1)
+      nir_store_output(b, nir_imm_vec4(b, 1, 1, 1, 1), nir_imm_int(b, 0),
+                       .write_mask = (1u << n1) - 1,
+                       .io_semantics.location = VARYING_SLOT_CLIP_DIST1);
+   nir_emit_vertex(b, 0);
+}
