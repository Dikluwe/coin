+{
+   if (!prog || !prog->serialized_nir)
+      return false;
+
+   struct blob_reader reader;
+   blob_reader_init(&reader, prog->serialized_nir,
+                    prog->serialized_nir_size);
+   nir_shader *shader = nir_deserialize(NULL,
+      st_get_nir_compiler_options(st, prog->info.stage), &reader);
+   if (!shader)
+      return false;
+   if (shader->info.io_lowered)
+      st_nir_unlower_io_to_vars(shader);
+
+   uint64_t seen = 0;
+   bool safe = true;
+   nir_foreach_variable_with_modes(var, shader,
+                                   fragment ? nir_var_shader_in : nir_var_shader_out) {
+      unsigned slot = var->data.location;
+      if (slot < VARYING_SLOT_VAR0 || slot >= 64 ||
+          !(slots & BITFIELD64_BIT(slot)))
+         continue;
+      if (!glsl_type_is_vector_or_scalar(var->type) ||
+          glsl_get_base_type(var->type) != GLSL_TYPE_FLOAT ||
+          glsl_get_bit_size(var->type) != 32 ||
+          var->data.location_frac || var->data.compact ||
+          (fragment && var->data.interpolation != INTERP_MODE_SMOOTH &&
+           var->data.interpolation != INTERP_MODE_NONE)) {
+         safe = false;
+         break;
+      }
+      seen |= BITFIELD64_BIT(slot);
+   }
+   ralloc_free(shader);
+   return safe && seen == slots;
+}
