{
  "builds": [
    "cmake --build /tmp/coin-pbr-bgfx -j6",
    "cmake --build /tmp/coin-pbr-recording -j6",
    "env CARGO_NET_OFFLINE=true cmake --build /tmp/coin-pbr-rust -j6"
  ],
  "ctest_regex": {
    "BGFX": "^(CoinRenderPbr.*Test|CoinRenderActionTest|CoinRenderBackendBoundaryTest|CoinRenderPlanAssemblyCoreTest|CoinRenderTransformCoreTest|CoinRenderFrameReuseCoreTest|CoinRenderLightingTest|CoinRenderSelection_vulkan|CoinRenderProductTest|CoinBgfxWindowTest|CoinRenderPublicationTest|CoinRenderDepthContractVulkanTest|CoinRenderClipPlane_vulkan_object|CoinRenderGouraud_vulkan_object|CoinBgfxOffscreenTest)$",
    "RECORDING": "^(CoinRenderPbr.*Test|CoinRenderActionTest|CoinRenderBackendBoundaryTest|CoinRenderPlanAssemblyCoreTest|CoinRenderTransformCoreTest|CoinRenderFrameReuseCoreTest|CoinRenderLightingTest|CoinRenderPublicationTest)$",
    "RUST_BRIDGE": "^(CoinRenderPbr.*Test|CoinRenderActionTest|CoinRenderBackendBoundaryTest|CoinRenderPlanAssemblyCoreTest|CoinRenderTransformCoreTest|CoinRenderFrameReuseCoreTest|CoinRenderLightingTest|CoinRenderProductTest|CoinRenderPublicationTest)$"
  },
  "environment": {
    "DISPLAY": ":0",
    "VK_DRIVER_FILES": "/usr/share/vulkan/icd.d/radeon_icd.json",
    "COIN_BGFX_RENDERER": "vulkan",
    "WGPU_BACKEND": "vulkan"
  },
  "views": "python3 docs/validation/pbr/m3/run-m3.py --environments /tmp/coin-pbr-m3-env",
  "legacy": "python3 docs/validation/pbr/m0/run-m0.py --output /tmp/coin-pbr-m3-baseline --cad-source <m0/cad-source.json path>",
  "bake": [
    "coin_render_pbr_baker --source studio --output studio.cibl",
    "coin_render_pbr_baker --source asymmetric --output asymmetric.cibl"
  ]
}
