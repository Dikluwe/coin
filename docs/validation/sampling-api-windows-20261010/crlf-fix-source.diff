+            << " floor_oracle=" << (options.textureSamplingPolicy==COIN_RENDER_SAMPLING_PORTABLE)
+            << " maximumRGB=" << maximum << " result=" << ok << '\n';
+  if(!ok)std::cerr << action.getLastError().getString() << '\n';
+  action.setRenderTarget(nullptr);root->unref();return ok;
+}
