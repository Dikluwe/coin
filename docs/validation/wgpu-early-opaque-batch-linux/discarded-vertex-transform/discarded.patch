+#include <vector>
 #define CHECK(c) do { if (!(c)) { std::cerr << "Failed: " << #c << " at " << __LINE__ << '\n'; return 1; } } while (0)
+namespace {
+bool sameVector(const SbVec3f & a, const SbVec3f & b) {
+  for (int c = 0; c < 3; ++c)
+    if (!(std::isnan(a[c]) && std::isnan(b[c])) &&
+        std::memcmp(&a[c], &b[c], sizeof(float)) != 0) return false;
+  return true;
+}
+bool preparedVertexTransforms() {
+  std::vector<SbMatrix> matrices{SbMatrix::identity()};
+  auto signedZero = SbMatrix::identity(); signedZero[1][0] = -0.0f;
+  matrices.push_back(signedZero);
+  for (int i = 0; i < 32; ++i) {
+    const float f = float(i) / 7.0f;
+    SbMatrix affine(1+f,.2f,-.3f,0, -.1f,2-f,.7f,0,
+                    .3f,-.2f,.5f+f,0, 13-f,-9+f,2*f,1);
+    matrices.push_back(affine);
+    affine[0][3] = .031f; affine[1][3] = -.023f; affine[3][3] = .8f;
+    matrices.push_back(affine);
+    affine.setScale(SbVec3f(0,1+f,-2-f)); matrices.push_back(affine);
+  }
+  std::vector<SbVec3f> points{SbVec3f(-0.0f,0,-0.0f), SbVec3f(1,-2,3),
+    SbVec3f(std::numeric_limits<float>::infinity(),1,-1),
+    SbVec3f(std::numeric_limits<float>::quiet_NaN(),0,0)};
+  for (int i = -10; i <= 10; ++i) points.emplace_back(i*.37f,i*-.91f,i*1.13f);
+  for (const auto & matrix : matrices) {
+    CoinRenderVertexTransformCore prepared(matrix);
+    for (const auto & point : points) {
+      SbVec3f expected, actual;
+      matrix.multVecMatrix(point,expected); prepared.point(point,actual);
+      if (!sameVector(expected,actual)) return false;
+      actual = point; prepared.point(actual,actual);
+      if (!sameVector(expected,actual)) return false;
+      matrix.multDirMatrix(point,expected); prepared.direction(point,actual);
+      if (!sameVector(expected,actual)) return false;
+      actual = point; prepared.direction(actual,actual);
+      if (!sameVector(expected,actual)) return false;
+    }
+  }
+  SbMatrix source; source.setTranslate(SbVec3f(2,3,4));
+  const CoinRenderVertexTransformCore owned(source); source.makeIdentity();
+  SbVec3f output; owned.point(SbVec3f(1,2,3),output);
+  return output == SbVec3f(3,5,7);
+}
+}
 int main() {
+  CHECK(preparedVertexTransforms());
   const auto identity = SbMatrix::identity();
   CHECK(CoinRenderTransformCore::projection(identity, true) == identity);
   const auto zeroToOne = CoinRenderTransformCore::projection(identity, false);
