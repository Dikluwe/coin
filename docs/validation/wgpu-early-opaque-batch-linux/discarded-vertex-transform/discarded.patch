diff --git a/src/rendering/coinrender/CoinRenderTransformCore.h b/src/rendering/coinrender/CoinRenderTransformCore.h
index 42b9c15e94..58a62695bb 100644
--- a/src/rendering/coinrender/CoinRenderTransformCore.h
+++ b/src/rendering/coinrender/CoinRenderTransformCore.h
@@ -3,6 +3,7 @@
 #include "rendering/coinrender/CoinRenderFramePlan.h"
 #include <algorithm>
 #include <cmath>
+#include <cstring>
 
 // Coin-native transforms over captured values. GPU packing and API conventions
 // select parameters; this Core does not know BGFX, wgpu, actions or devices.
@@ -49,4 +50,38 @@ public:
     return true;
   }
 };
+
+// Prepared once per geometry range, then reused for every vertex. Keep Coin's
+// exact arithmetic (including projective division) and identity byte test.
+// This owns its captured matrix and has no frame, cache or device lifetime.
+class CoinRenderVertexTransformCore {
+public:
+  explicit CoinRenderVertexTransformCore(const SbMatrix & matrix) {
+    std::memcpy(this->matrix, matrix.getValue(), sizeof(this->matrix));
+    const SbMatrix identity = SbMatrix::identity();
+    const float * values = this->matrix[0];
+    this->identity = values[0] == 1.0f &&
+      std::memcmp(values + 1, identity[0] + 1, 15 * sizeof(float)) == 0;
+  }
+  void point(const SbVec3f & source, SbVec3f & destination) const {
+    if (this->identity) { destination = source; return; }
+    const float x = source[0], y = source[1], z = source[2];
+    const auto & m = this->matrix;
+    const float w = x*m[0][3] + y*m[1][3] + z*m[2][3] + m[3][3];
+    destination[0] = (x*m[0][0] + y*m[1][0] + z*m[2][0] + m[3][0])/w;
+    destination[1] = (x*m[0][1] + y*m[1][1] + z*m[2][1] + m[3][1])/w;
+    destination[2] = (x*m[0][2] + y*m[1][2] + z*m[2][2] + m[3][2])/w;
+  }
+  void direction(const SbVec3f & source, SbVec3f & destination) const {
+    if (this->identity) { destination = source; return; }
+    const float x = source[0], y = source[1], z = source[2];
+    const auto & m = this->matrix;
+    destination[0] = x*m[0][0] + y*m[1][0] + z*m[2][0];
+    destination[1] = x*m[0][1] + y*m[1][1] + z*m[2][1];
+    destination[2] = x*m[0][2] + y*m[1][2] + z*m[2][2];
+  }
+private:
+  float matrix[4][4];
+  bool identity;
+};
 #endif
