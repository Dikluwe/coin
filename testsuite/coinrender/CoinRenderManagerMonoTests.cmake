if(TARGET CoinRender AND UNIX AND NOT APPLE AND X11_FOUND)
  add_executable(CoinRenderManagerMonoContractTest CoinRenderManagerMonoContractTest.cpp)
  target_compile_definitions(CoinRenderManagerMonoContractTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
  target_include_directories(CoinRenderManagerMonoContractTest PRIVATE
    ${PROJECT_SOURCE_DIR}/testsuite/coinrender ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src
    ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES} ${X11_INCLUDE_DIR})
  target_link_libraries(CoinRenderManagerMonoContractTest CoinRender Coin ${X11_LIBRARIES} ${CMAKE_DL_LIBS})
  if(TARGET OpenGL::GL)
    target_link_libraries(CoinRenderManagerMonoContractTest OpenGL::GL)
  else()
    target_link_libraries(CoinRenderManagerMonoContractTest ${OPENGL_gl_LIBRARY})
  endif()
  if(COIN_RENDER_BACKEND STREQUAL "BGFX")
    target_compile_definitions(CoinRenderManagerMonoContractTest PRIVATE COIN_MANAGER_MONO_BGFX)
  endif()
  add_test(NAME CoinRenderManagerMonoCore COMMAND CoinRenderManagerMonoContractTest --core)
  set_tests_properties(CoinRenderManagerMonoCore PROPERTIES TIMEOUT 30)
  if(COIN_RENDER_BACKEND STREQUAL "BGFX" OR COIN_RENDER_BACKEND STREQUAL "RUST_BRIDGE")
    function(coin_manager_mono_gpu name)
      add_test(NAME CoinRenderManagerMono${name} COMMAND CoinRenderManagerMonoContractTest ${ARGN})
      # Missing accelerated/native/GL evidence is a failure, never a skipped PASS.
      set_tests_properties(CoinRenderManagerMono${name} PROPERTIES TIMEOUT 120 RESOURCE_LOCK coinrender_gpu RUN_SERIAL TRUE)
    endfunction()
    coin_manager_mono_gpu(Layers1 --layers)
    coin_manager_mono_gpu(Layers2 --layers --samples 2)
    coin_manager_mono_gpu(Layers4Portable --layers --samples 4 --portable-sampling)
    coin_manager_mono_gpu(Textures1 --textures)
    coin_manager_mono_gpu(TexturesSrgbPortable --textures --srgb --portable-sampling)
    coin_manager_mono_gpu(Textures4 --textures --samples 4)
    coin_manager_mono_gpu(RttDirect1 --rtt --direct)
    coin_manager_mono_gpu(RttStaged1 --rtt --staged)
    coin_manager_mono_gpu(RttDirect2Portable --rtt --direct --samples 2 --portable-sampling)
    coin_manager_mono_gpu(RttStaged4 --rtt --staged --samples 4)
    coin_manager_mono_gpu(WindowLayers1 --window --layers)
    coin_manager_mono_gpu(WindowLayers4Portable --window --layers --samples 4 --portable-sampling)
    coin_manager_mono_gpu(WindowTextures2 --window --textures --samples 2)
    coin_manager_mono_gpu(WindowRttDirect1 --window --rtt --direct)
    coin_manager_mono_gpu(WindowRttStaged2Portable --window --rtt --staged --samples 2 --portable-sampling)
    coin_manager_mono_gpu(Peers1 --peers)
    coin_manager_mono_gpu(Peers4Portable --peers --samples 4 --portable-sampling)
  endif()
endif()
