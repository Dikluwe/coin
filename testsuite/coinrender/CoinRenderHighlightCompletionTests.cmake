if(TARGET CoinRender AND UNIX AND NOT APPLE AND X11_FOUND)
  add_executable(CoinRenderHighlightCompletionTest
    CoinRenderHighlightCompletionTest.cpp CoinRenderStereoStencilReference.cpp)
  target_compile_definitions(CoinRenderHighlightCompletionTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
  target_include_directories(CoinRenderHighlightCompletionTest PRIVATE
    ${PROJECT_SOURCE_DIR}/testsuite/coinrender ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src
    ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES} ${X11_INCLUDE_DIR})
  target_link_libraries(CoinRenderHighlightCompletionTest CoinRender Coin ${X11_LIBRARIES} ${CMAKE_DL_LIBS})
  if(TARGET OpenGL::GL)
    target_link_libraries(CoinRenderHighlightCompletionTest OpenGL::GL)
  else()
    target_link_libraries(CoinRenderHighlightCompletionTest ${OPENGL_gl_LIBRARY})
  endif()
  if(COIN_RENDER_BACKEND STREQUAL "BGFX")
    target_compile_definitions(CoinRenderHighlightCompletionTest PRIVATE COIN_MANAGER_MONO_BGFX)
  endif()
  function(coin_highlight_completion_cpu name)
    add_test(NAME CoinRenderHighlightCompletionCpu_${name} COMMAND CoinRenderHighlightCompletionTest --cpu ${ARGN})
    set_tests_properties(CoinRenderHighlightCompletionCpu_${name} PROPERTIES TIMEOUT 30 LABELS "r35_completion;coinrender_cpu")
  endfunction()
  # One finite profile per process. All seven physical cells execute these
  # exact tests; renderer/device selection belongs to the matrix runner.
  coin_highlight_completion_cpu(BoxMonoTechnical --box --mono --mode 4)
  coin_highlight_completion_cpu(LineAnaglyph --line --anaglyph)
  coin_highlight_completion_cpu(BoxRows --box --rows --mode 6)
  coin_highlight_completion_cpu(LineColumnsPaths --line --columns --paths --mode 3)
  if(COIN_RENDER_BACKEND STREQUAL "BGFX" OR COIN_RENDER_BACKEND STREQUAL "RUST_BRIDGE")
    function(coin_highlight_completion_gpu name)
      add_test(NAME CoinRenderHighlightCompletion_${name} COMMAND CoinRenderHighlightCompletionTest ${ARGN})
      # Missing GPU, missing native reference and B95 are failures. No skip,
      # no retry, and no extra frame inside the passive five-second observer.
      set_tests_properties(CoinRenderHighlightCompletion_${name} PROPERTIES
        TIMEOUT 120 RESOURCE_LOCK coinrender_gpu RUN_SERIAL TRUE LABELS "r35_completion;coinrender_gpu")
    endfunction()
    foreach(_kind box line)
      coin_highlight_completion_gpu(${_kind}_Mono1 --${_kind} --mono)
      coin_highlight_completion_gpu(${_kind}_Anaglyph1 --${_kind} --anaglyph)
      coin_highlight_completion_gpu(${_kind}_Rows2 --${_kind} --rows --samples 2)
      coin_highlight_completion_gpu(${_kind}_Columns4Portable --${_kind} --columns --samples 4 --portable-sampling)
      # Every technical mode is a separate process, rotating stereo/MSAA/policy.
      coin_highlight_completion_gpu(${_kind}_WireMono1 --${_kind} --mono --profile technical --mode 1)
      coin_highlight_completion_gpu(${_kind}_PointsRows2 --${_kind} --rows --profile technical --mode 2 --samples 2)
      coin_highlight_completion_gpu(${_kind}_OverlayColumns4Portable --${_kind} --columns --profile technical --mode 3 --samples 4 --portable-sampling)
      coin_highlight_completion_gpu(${_kind}_HiddenAnaglyph1 --${_kind} --anaglyph --profile technical --mode 4)
      coin_highlight_completion_gpu(${_kind}_BoundsRows4Portable --${_kind} --rows --profile technical --mode 5 --samples 4 --portable-sampling)
      coin_highlight_completion_gpu(${_kind}_ShadedColumns2 --${_kind} --columns --profile technical --mode 6 --samples 2)
      coin_highlight_completion_gpu(${_kind}_History --${_kind} --rows --profile history --samples 2)
      coin_highlight_completion_gpu(${_kind}_Layers --${_kind} --anaglyph --profile layers --samples 2)
      coin_highlight_completion_gpu(${_kind}_Paths --${_kind} --columns --profile paths --samples 4 --portable-sampling --mode 3)
      coin_highlight_completion_gpu(${_kind}_Refusal --${_kind} --anaglyph --profile refusal)
      coin_highlight_completion_gpu(${_kind}_Occlusion --${_kind} --columns --profile occlusion --samples 2)
      coin_highlight_completion_gpu(${_kind}_RttDirect --${_kind} --anaglyph --profile resources --direct)
      coin_highlight_completion_gpu(${_kind}_RttStaged --${_kind} --rows --profile resources --staged --samples 2 --portable-sampling)
      coin_highlight_completion_gpu(${_kind}_Vsm --${_kind} --columns --profile shadows --samples 2)
      coin_highlight_completion_gpu(${_kind}_RttVsm --${_kind} --rows --profile combined --direct --samples 2)
      coin_highlight_completion_gpu(${_kind}_Raster --${_kind} --anaglyph --profile raster --samples 2)
      coin_highlight_completion_gpu(${_kind}_Weighted4 --${_kind} --rows --profile alpha --samples 4 --weighted --portable-sampling)
      coin_highlight_completion_gpu(${_kind}_Peeling2 --${_kind} --columns --profile alpha --samples 2 --peeling)
      coin_highlight_completion_gpu(${_kind}_Window --${_kind} --rows --profile window --window --samples 2)
    endforeach()
    # The environment is process-scoped: Coin caches this native policy.
    foreach(_override 0 1)
      foreach(_alpha 0 1 2 3 4 5)
        coin_highlight_completion_gpu(LineAlpha${_alpha}Override${_override}
          --line --anaglyph --profile alpha --alpha ${_alpha})
        set_tests_properties(CoinRenderHighlightCompletion_LineAlpha${_alpha}Override${_override} PROPERTIES
          ENVIRONMENT "COIN_SEPARATE_DIFFUSE_TRANSPARENCY_OVERRIDE=${_override}")
      endforeach()
    endforeach()
    coin_highlight_completion_gpu(CoupledBoxDirect --box --anaglyph --profile coupled --direct)
    coin_highlight_completion_gpu(CoupledLineStaged --line --rows --profile coupled --staged --samples 2 --portable-sampling)
    coin_highlight_completion_gpu(PeersBoxDirect --box --rows --profile peers --direct)
    coin_highlight_completion_gpu(PeersLineStaged --line --anaglyph --profile peers --staged --samples 2 --portable-sampling)
  endif()
endif()
