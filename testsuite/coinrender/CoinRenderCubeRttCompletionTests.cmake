if(TARGET CoinRenderCubeRttTest)
  add_executable(CoinRenderCubeRttSourceTest CoinRenderCubeRttSourceTest.cpp)
  target_sources(CoinRenderCubeRttSourceTest PRIVATE ${PROJECT_SOURCE_DIR}/src/rendering/coinwgpu/CoinWgpuFfiFrame.cpp ${PROJECT_SOURCE_DIR}/src/rendering/coinwgpu/CoinWgpuShadowFrame.cpp)
  target_compile_definitions(CoinRenderCubeRttSourceTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
  target_link_libraries(CoinRenderCubeRttSourceTest CoinRender Coin)
  target_include_directories(CoinRenderCubeRttSourceTest PRIVATE ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES})
  if(COIN_RENDER_BACKEND STREQUAL "RECORDING")
    add_executable(CoinRenderCubeRttCpuFaultTest CoinRenderCubeRttCpuFaultTest.cpp)
    target_compile_definitions(CoinRenderCubeRttCpuFaultTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
    target_link_libraries(CoinRenderCubeRttCpuFaultTest CoinRender Coin)
    target_include_directories(CoinRenderCubeRttCpuFaultTest PRIVATE ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES})
    foreach(cube_fault sixth nested root refusals thread sixth-invalid late-capability)
      add_test(NAME CoinRenderCubeRttNativeCpu_${cube_fault} COMMAND CoinRenderCubeRttCpuFaultTest --${cube_fault})
      set_tests_properties(CoinRenderCubeRttNativeCpu_${cube_fault} PROPERTIES TIMEOUT 180)
    endforeach()
    foreach(cube_family 0 1 2)
      add_test(NAME CoinRenderCubeRttSourceCpu_${cube_family} COMMAND CoinRenderCubeRttSourceTest --recording --family ${cube_family})
      add_test(NAME CoinRenderCubeRttSourceCpuPreflight_${cube_family} COMMAND CoinRenderCubeRttSourceTest --recording --preflight --family ${cube_family})
      set_tests_properties(CoinRenderCubeRttSourceCpu_${cube_family} CoinRenderCubeRttSourceCpuPreflight_${cube_family} PROPERTIES TIMEOUT 180)
    endforeach()
    foreach(cube_current_family 0 1)
      add_test(NAME CoinRenderCubeRttSourceCpuCurrent_${cube_current_family} COMMAND CoinRenderCubeRttSourceTest --recording --same-revision --family ${cube_current_family})
      set_tests_properties(CoinRenderCubeRttSourceCpuCurrent_${cube_current_family} PROPERTIES TIMEOUT 180)
    endforeach()
    add_test(NAME CoinRenderCubeRttSourceCpuAlpha COMMAND CoinRenderCubeRttSourceTest --recording --family 1 --unit 7 --alpha)
    set_tests_properties(CoinRenderCubeRttSourceCpuAlpha PROPERTIES TIMEOUT 180)
  else()
    # Selected crossings: source family, route, MSAA and sampling policy are
    # explicit per campaign. This is intentionally not a Cartesian claim.
    foreach(cube_family 0 1 2)
      add_test(NAME CoinRenderCubeRttSourceGpuStaged_${cube_family} COMMAND CoinRenderCubeRttSourceTest --family ${cube_family} --unit 0)
      add_test(NAME CoinRenderCubeRttSourceGpuDirectPortable_${cube_family} COMMAND CoinRenderCubeRttSourceTest --family ${cube_family} --unit 7 --samples 4 --direct --portable-sampling)
      set_tests_properties(CoinRenderCubeRttSourceGpuStaged_${cube_family} CoinRenderCubeRttSourceGpuDirectPortable_${cube_family} PROPERTIES TIMEOUT 180 SKIP_RETURN_CODE 77 RESOURCE_LOCK coinrender_gpu)
    endforeach()
    add_test(NAME CoinRenderCubeRttSourceGpuDirectFaults COMMAND CoinRenderCubeRttSourceTest --direct-faults)
    set_tests_properties(CoinRenderCubeRttSourceGpuDirectFaults PROPERTIES TIMEOUT 180 SKIP_RETURN_CODE 77 RESOURCE_LOCK coinrender_gpu)
    add_test(NAME CoinRenderCubeRttSourceGpuCurrent2D COMMAND CoinRenderCubeRttSourceTest --same-revision --family 0 --direct)
    add_test(NAME CoinRenderCubeRttSourceGpuCurrentVolume COMMAND CoinRenderCubeRttSourceTest --same-revision --family 1 --portable-sampling)
    set_tests_properties(CoinRenderCubeRttSourceGpuCurrent2D CoinRenderCubeRttSourceGpuCurrentVolume PROPERTIES TIMEOUT 180 SKIP_RETURN_CODE 77 RESOURCE_LOCK coinrender_gpu)
    add_test(NAME CoinRenderCubeRttSourceGpu2Native COMMAND CoinRenderCubeRttSourceTest --family 0 --unit 7 --samples 2 --direct --alpha)
    add_test(NAME CoinRenderCubeRttSourceGpu2Portable COMMAND CoinRenderCubeRttSourceTest --family 1 --unit 0 --samples 2 --portable-sampling --alpha)
    add_test(NAME CoinRenderCubeRttSourceGpuPreflight COMMAND CoinRenderCubeRttSourceTest --family 2 --direct --preflight)
    set_tests_properties(CoinRenderCubeRttSourceGpu2Native CoinRenderCubeRttSourceGpu2Portable CoinRenderCubeRttSourceGpuPreflight PROPERTIES TIMEOUT 180 SKIP_RETURN_CODE 77 RESOURCE_LOCK coinrender_gpu)
    if(X11_FOUND)
      add_executable(CoinRenderCubeRttSourceWindowTest CoinRenderCubeRttSourceWindowTest.cpp)
      target_compile_definitions(CoinRenderCubeRttSourceWindowTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
      target_link_libraries(CoinRenderCubeRttSourceWindowTest CoinRender Coin ${X11_LIBRARIES})
      target_include_directories(CoinRenderCubeRttSourceWindowTest PRIVATE ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES} ${X11_INCLUDE_DIR})
      add_test(NAME CoinRenderCubeRttSourceWindow COMMAND CoinRenderCubeRttSourceWindowTest --family 2 --unit 7 --direct --portable-sampling)
      set_tests_properties(CoinRenderCubeRttSourceWindow PROPERTIES TIMEOUT 180 SKIP_RETURN_CODE 77 RESOURCE_LOCK coinrender_gpu)
    endif()
  endif()
endif()
