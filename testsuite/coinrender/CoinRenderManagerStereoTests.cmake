if(TARGET CoinRender AND UNIX AND NOT APPLE AND X11_FOUND)
  add_executable(CoinRenderManagerStereoContractTest CoinRenderManagerStereoContractTest.cpp CoinRenderStereoStencilReference.cpp)
  add_executable(CoinRenderStereoStencilBitmapTest CoinRenderStereoStencilBitmapTest.cpp)
  add_test(NAME CoinRenderStereoStencilBitmapCpu COMMAND CoinRenderStereoStencilBitmapTest)
  set_tests_properties(CoinRenderStereoStencilBitmapCpu PROPERTIES TIMEOUT 30)
  target_compile_definitions(CoinRenderManagerStereoContractTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
  target_include_directories(CoinRenderManagerStereoContractTest PRIVATE
    ${PROJECT_SOURCE_DIR}/testsuite/coinrender ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src
    ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES} ${X11_INCLUDE_DIR})
  target_link_libraries(CoinRenderManagerStereoContractTest CoinRender Coin ${X11_LIBRARIES} ${CMAKE_DL_LIBS})
  if(TARGET OpenGL::GL)
    target_link_libraries(CoinRenderManagerStereoContractTest OpenGL::GL)
  else()
    target_link_libraries(CoinRenderManagerStereoContractTest ${OPENGL_gl_LIBRARY})
  endif()
  if(COIN_RENDER_BACKEND STREQUAL "BGFX")
    target_compile_definitions(CoinRenderManagerStereoContractTest PRIVATE COIN_MANAGER_MONO_BGFX)
  endif()
  add_test(NAME CoinRenderManagerStereoCore COMMAND CoinRenderManagerStereoContractTest --core)
  set_tests_properties(CoinRenderManagerStereoCore PROPERTIES TIMEOUT 30)
  if(COIN_RENDER_BACKEND STREQUAL "BGFX" OR COIN_RENDER_BACKEND STREQUAL "RUST_BRIDGE")
    function(coin_manager_stereo_gpu name)
      add_test(NAME CoinRenderManagerStereo${name} COMMAND CoinRenderManagerStereoContractTest ${ARGN})
      # A missing GPU/reference and the known physical stale-present failure
      # remain failures. No successful qualification by SKIP_RETURN_CODE.
      set_tests_properties(CoinRenderManagerStereo${name} PROPERTIES
        TIMEOUT 120 RESOURCE_LOCK coinrender_gpu RUN_SERIAL TRUE)
    endfunction()
    foreach(_stereo anaglyph rows columns)
      coin_manager_stereo_gpu(${_stereo}Cameras1 --${_stereo} --cameras)
      coin_manager_stereo_gpu(${_stereo}Layers1 --${_stereo} --layers)
      coin_manager_stereo_gpu(${_stereo}Refusal1 --${_stereo} --refusal)
    endforeach()
    coin_manager_stereo_gpu(AnaglyphDepth1 --anaglyph --depth)
    coin_manager_stereo_gpu(RowsDepth2 --rows --depth --samples 2)
    coin_manager_stereo_gpu(ColumnsDepth4Portable --columns --depth --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphAlpha1 --anaglyph --alpha)
    coin_manager_stereo_gpu(AnaglyphAlpha2 --anaglyph --alpha --samples 2)
    coin_manager_stereo_gpu(AnaglyphAlpha4Portable --anaglyph --alpha --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(RowsAlpha2 --rows --alpha --samples 2)
    coin_manager_stereo_gpu(ColumnsAlpha4Portable --columns --alpha --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphTechnical1 --anaglyph --technical)
    coin_manager_stereo_gpu(RowsTechnical2 --rows --technical --samples 2)
    coin_manager_stereo_gpu(ColumnsTechnical4Portable --columns --technical --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphWeighted1 --anaglyph --oit --weighted)
    coin_manager_stereo_gpu(RowsWeighted4Portable --rows --oit --weighted --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(ColumnsPeeling2 --columns --oit --peeling --samples 2)
    coin_manager_stereo_gpu(OrthographicRows1 --rows --cameras --orthographic)
    coin_manager_stereo_gpu(OrthographicColumns4 --columns --cameras --orthographic --samples 4)
    coin_manager_stereo_gpu(AnaglyphRaster1 --anaglyph --raster)
    coin_manager_stereo_gpu(RowsRaster2Portable --rows --raster --samples 2 --portable-sampling)
    coin_manager_stereo_gpu(ColumnsRaster4 --columns --raster --samples 4)
    coin_manager_stereo_gpu(AnaglyphShadows1 --anaglyph --shadows)
    coin_manager_stereo_gpu(RowsShadows4Portable --rows --shadows --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(ColumnsShadows2 --columns --shadows --samples 2)
    coin_manager_stereo_gpu(RowsCameras2 --rows --cameras --samples 2)
    coin_manager_stereo_gpu(ColumnsCameras4Portable --columns --cameras --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphLayers4 --anaglyph --layers --samples 4)
    coin_manager_stereo_gpu(RowsLayers2Portable --rows --layers --samples 2 --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphResources1 --anaglyph --resources)
    coin_manager_stereo_gpu(RowsResources2Portable --rows --resources --samples 2 --portable-sampling)
    coin_manager_stereo_gpu(ColumnsResources4 --columns --resources --samples 4)
    coin_manager_stereo_gpu(AnaglyphResourcesSrgb --anaglyph --resources --srgb --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphRttDirect1 --anaglyph --rtt --direct)
    coin_manager_stereo_gpu(RowsRttStaged2 --rows --rtt --staged --samples 2)
    coin_manager_stereo_gpu(ColumnsRttDirect4Portable --columns --rtt --direct --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(RowsPeers1 --rows --peers)
    coin_manager_stereo_gpu(AnaglyphPeers4Portable --anaglyph --peers --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(RowsWindow1 --rows --cameras --window)
    coin_manager_stereo_gpu(ColumnsWindow4Portable --columns --cameras --window --samples 4 --portable-sampling)
    coin_manager_stereo_gpu(AnaglyphWindowLayers2 --anaglyph --layers --window --samples 2)
    coin_manager_stereo_gpu(RowsWindowRttDirect1 --rows --rtt --direct --window)
    coin_manager_stereo_gpu(ColumnsWindowRttStaged2Portable --columns --rtt --staged --window --samples 2 --portable-sampling)
  endif()
