if(TARGET CoinRenderCubeRttTest AND COIN_RENDER_BACKEND STREQUAL "RECORDING")
  add_test(NAME CoinRenderCubeRttPublicCpuSmoke COMMAND CoinRenderCubeRttSmokeTest --recording --staged)
  foreach(cube_cpu_focal faces camera orthographic transformed models sampling state alpha transport override nested invalid mixed producer-state)
    add_test(NAME CoinRenderCubeRttPublicCpu_${cube_cpu_focal} COMMAND CoinRenderCubeRttTest --recording --${cube_cpu_focal})
    set_tests_properties(CoinRenderCubeRttPublicCpu_${cube_cpu_focal} PROPERTIES TIMEOUT 180)
  endforeach()
  add_test(NAME CoinRenderCubeRttPublicCpuGraphDepth8 COMMAND CoinRenderCubeRttTest --recording --graph-depth --levels 8)
  add_test(NAME CoinRenderCubeRttPublicCpuCallbackDepth3 COMMAND CoinRenderCubeRttTest --recording --callback-depth --levels 3)
  set_tests_properties(CoinRenderCubeRttPublicCpuGraphDepth8 CoinRenderCubeRttPublicCpuCallbackDepth3 PROPERTIES TIMEOUT 180)
  foreach(cube_cpu_sharing shared dependency-filter observable contexts function stereo stereo-shared transitive)
    add_test(NAME CoinRenderCubeRttPublicCpuSharing_${cube_cpu_sharing} COMMAND CoinRenderCubeRttSharingTest --recording --${cube_cpu_sharing})
    set_tests_properties(CoinRenderCubeRttPublicCpuSharing_${cube_cpu_sharing} PROPERTIES TIMEOUT 180)
  endforeach()
  add_executable(CoinRenderCubeRttCpuFactoryTest CoinRenderCubeRttCpuFactoryTest.cpp)
  target_compile_definitions(CoinRenderCubeRttCpuFactoryTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
  target_link_libraries(CoinRenderCubeRttCpuFactoryTest CoinRender Coin)
  target_include_directories(CoinRenderCubeRttCpuFactoryTest PRIVATE ${PROJECT_SOURCE_DIR}/include ${PROJECT_SOURCE_DIR}/src ${PROJECT_BINARY_DIR}/include ${PROJECT_BINARY_DIR}/src ${COIN_TARGET_INCLUDE_DIRECTORIES})
  foreach(cube_cpu_aux refusals late)
    add_test(NAME CoinRenderCubeRttPublicCpu_${cube_cpu_aux} COMMAND CoinRenderCubeRttCpuFactoryTest --${cube_cpu_aux})
    set_tests_properties(CoinRenderCubeRttPublicCpu_${cube_cpu_aux} PROPERTIES TIMEOUT 180)
  endforeach()
  foreach(cube_cpu_extent 1 2 2048)
    foreach(cube_cpu_mips base mips)
      set(cube_cpu_mip_flag)
      if(cube_cpu_mips STREQUAL "mips")
        set(cube_cpu_mip_flag --mips)
      endif()
      add_test(NAME CoinRenderCubeRttPublicCpuLimit_${cube_cpu_extent}_${cube_cpu_mips}
        COMMAND CoinRenderCubeRttTest --recording --limits --extent ${cube_cpu_extent} ${cube_cpu_mip_flag})
      set_tests_properties(CoinRenderCubeRttPublicCpuLimit_${cube_cpu_extent}_${cube_cpu_mips}
        PROPERTIES TIMEOUT 180)
    endforeach()
  endforeach()
endif()
