# Executed by freecad_screen_content.FCMacro only when explicitly requested.
# Each process exercises one real document consumer, starting without a GL frame.
import ctypes
import sys
import subprocess
import re
import time
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['COIN_TEST_MACRO_DIR'])
from host_consumer_oracles import (CONSUMERS, LABEL_CONSUMERS, require_content,
                                  require_mutation, require_cleanup,
                                  require_pointer_identity, require_drag,
                                  require_idle, require_dpr, require_interactive_mesh,
                                  require_single_coin, require_host_hover, require_host_selection,
                                  canonical_topology_identity, require_released_draggers,
                                  NativePublicationQuietWindow)
from shiboken6 import isValid, getCppPointer

consumer_name = os.environ['COIN_TEST_HOST_CONSUMER']
if consumer_name not in CONSUMERS:
    raise RuntimeError('unknown host consumer: ' + consumer_name)
if os.environ.get('COIN_TEST_ISOLATED_X11') != '1':
    raise RuntimeError('host consumer input requires run_isolated.py')
report.update(test='freecad-host-consumer', consumer=consumer_name,
              profile=consumer_name, scope='one document consumer', stages=[])
# Private per-process UI profile: an overlaid Tasks dock can both cover pixels
# and intercept native mouse motion. Keep document consumers in a clear viewport.
for overlay_name in ('OverlayLeft', 'OverlayRight', 'OverlayTop', 'OverlayBottom'):
    overlay_group = App.ParamGet('User parameter:BaseApp/MainWindow/DockWindows/' + overlay_name)
    overlay_group.SetString('Widgets', '')
    overlay_group.SetBool('TaskShow', False)
    overlay_group.SetBool('EditShow', False)
report['private_ui_profile'] = {'overlay_widgets': [], 'TaskShow': False, 'EditShow': False}
failure_finish = finish
drag_probe = None
event_callbacks = []


def finish(error=None):
    if error is not None:
        failure_finish(error)
        return
    try:
        global drag_probe
        if drag_probe:
            host_helper.host_consumer_drag_probe_destroy(drag_probe)
            drag_probe = None
        if 'input_observer' in globals():
            input_observer.close()
        if 'view' in globals():
            for event_type, callback in event_callbacks:
                view.removeEventCallback(event_type, callback)
            event_callbacks.clear()
        Gui.Selection.clearSelection()
        if Gui.activeDocument() and Gui.activeDocument().getInEdit():
            Gui.activeDocument().resetEdit()
        documents = list(App.listDocuments().values())
        if not documents:
            raise RuntimeError('host teardown has no document to save')
        for document in documents:
            document.recompute()
            document.saveAs(str(artifacts / (document.Name + '.FCStd')))
        for document in documents:
            App.closeDocument(document.Name)
        if App.listDocuments():
            raise RuntimeError('host teardown left an open document')
        x11.XCloseDisplay(display)
        report.update(status='PASS' if native else 'REFERENCE_PASS',
                      shutdown={'mode': 'normal-host-close', 'saved_documents': len(documents),
                                'documents_closed': True, 'probes_removed': True,
                                'filters_removed': True})
        (artifacts / 'result.json').write_text(json.dumps(report, indent=2))
        os.write(1, ('RESULT ' + json.dumps(report) + '\n').encode())
        def close_host():
            if not Gui.getMainWindow().close():
                failure_finish(RuntimeError('FreeCAD refused normal main-window close'))
        QtCore.QTimer.singleShot(0, close_host)
    except Exception as error:
        failure_finish(error)


try:
    report['coin_images'] = require_single_coin(Path('/proc/self/maps').read_text())
except Exception as error:
    finish(error)
