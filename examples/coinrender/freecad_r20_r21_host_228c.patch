 /**
  * Either renders the complete mesh or only a subset of the points.
  */
+void SoFCIndexedFaceSet::callback(SoCallbackAction* action)
+{
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+    if (action->isOfType(CoinRenderAction::getClassTypeId())
+        && Gui::SoFCInteractiveElement::get(action->getState())
+        && static_cast<unsigned>(coordIndex.getNum() / 4) > renderTriangleLimit) {
+        if (!renderTriangleLimit) {
+            static_cast<CoinRenderAction*>(action)->rejectUnsupported(
+                "SoFCIndexedFaceSet: interactive triangle limit must be positive");
+            return;
+        }
+        // Use 64 bits: the public unsigned limit can overflow 4 * limit.
+        const auto step = uint64_t(coordIndex.getNum()) / (4ULL * renderTriangleLimit) + 1;
+        auto* state = action->getState();
+        state->push();
+        SoPointSizeElement::set(state, this, float(std::min<uint64_t>(step, 3)));
+        inherited::callback(action);
+        state->pop();
+        return;
+    }
+#endif
+    inherited::callback(action);
+}
+
+void SoFCIndexedFaceSet::generatePrimitives(SoAction* action)
+{
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+    if (action->isOfType(CoinRenderAction::getClassTypeId())
+        && Gui::SoFCInteractiveElement::get(action->getState())
+        && static_cast<unsigned>(coordIndex.getNum() / 4) > renderTriangleLimit) {
+        auto* renderAction = static_cast<CoinRenderAction*>(action);
+        auto* state = action->getState();
+        state->push();
+        struct StateScope { SoState* state; ~StateScope() { state->pop(); } } scope {state};
+        if (vertexProperty.getValue()) vertexProperty.getValue()->doAction(action);
+        const auto* coordinates = SoCoordinateElement::getInstance(state);
+        const int count = coordIndex.getNum();
+        const auto fail = [&](const char* reason) { renderAction->rejectUnsupported(reason); };
+        if (!renderTriangleLimit || count % 4 != 0) {
+            fail("SoFCIndexedFaceSet: interactive reduction requires a positive limit and triangle records");
+            return;
+        }
+        // Validate before getVertexData can generate normals from these indices.
+        for (int i = 0; i < count; ++i) {
+            const int index = coordIndex[i];
+            if ((i % 4 == 3 && index != -1)
+                || (i % 4 != 3 && (index < 0 || index >= coordinates->getNum()))) {
+                fail("SoFCIndexedFaceSet: invalid triangle coordinates for interactive reduction");
+                return;
+            }
+        }
+        const SoCoordinateElement* coords = nullptr;
+        const SbVec3f* normals = nullptr;
+        const int32_t *indices = nullptr, *normalIndices = nullptr;
+        const int32_t *textureIndices = nullptr, *materialIndices = nullptr;
+        int numIndices = 0;
+        SbBool normalCacheUsed = FALSE;
+        getVertexData(state, coords, normals, indices, normalIndices, textureIndices,
+                      materialIndices, numIndices, TRUE, normalCacheUsed);
+        struct NormalScope {
+            SoFCIndexedFaceSet* node; SbBool locked;
+            ~NormalScope() { if (locked) node->readUnlockNormalCache(); }
+        } normalScope {this, normalCacheUsed};
+        auto normalBinding = SoNormalBindingElement::get(state);
+        if (normalCacheUsed && normalBinding == SoNormalBindingElement::PER_VERTEX)
+            normalBinding = SoNormalBindingElement::PER_VERTEX_INDEXED;
+        if (normalCacheUsed && normalBinding == SoNormalBindingElement::PER_FACE_INDEXED)
+            normalBinding = SoNormalBindingElement::PER_FACE;
+        const auto materialBinding = SoMaterialBindingElement::get(state);
+        const int normalCount = normalCacheUsed ? getNormalCache()->getNum()
+                                                : SoNormalElement::getInstance(state)->getNum();
+        const int normalIndexCount = normalCacheUsed ? getNormalCache()->getNumIndices()
+                                                     : normalIndex.getNum();
+        const int materialCount = SoLazyElement::getInstance(state)->getNumDiffuse();
+        const uint64_t step = uint64_t(count) / (4ULL * renderTriangleLimit) + 1;
+        // Mesh's legacy reduced pass emits three points for every step-th face.
+        // Keep the original coordinate/normal/material identity for observers.
+        struct Point { int coordinate; int normal; int material; };
+        std::vector<Point> points;
+        for (int face = 0; face < count / 4; ++face) {
+            if (uint64_t(face) % step) continue;
+            for (int corner = 0; corner < 3; ++corner) {
+                const int slot = face * 4 + corner;
+                const int coordinate = indices[slot];
+                int normal = 0;
+                switch (normalBinding) {
+                case SoNormalBindingElement::PER_PART:
+                case SoNormalBindingElement::PER_FACE: normal = face; break;
+                case SoNormalBindingElement::PER_PART_INDEXED:
+                case SoNormalBindingElement::PER_FACE_INDEXED:
+                    if (normalIndices && face >= normalIndexCount) {
+                        fail("SoFCIndexedFaceSet: short face normal indices"); return;
+                    }
+                    normal = normalIndices ? normalIndices[face] : face; break;
+                case SoNormalBindingElement::PER_VERTEX: normal = coordinate; break;
+                case SoNormalBindingElement::PER_VERTEX_INDEXED:
+                    if (normalIndices && slot >= normalIndexCount) {
+                        fail("SoFCIndexedFaceSet: short vertex normal indices"); return;
+                    }
+                    normal = normalIndices ? normalIndices[slot] : coordinate; break;
+                default: break;
+                }
+                // drawCoords uses the coordinate index for PER_VERTEX, the
+                // triangle ordinal for PER_FACE and material zero otherwise.
+                int material = 0;
+                if (materialBinding == SoMaterialBindingElement::PER_VERTEX) material = coordinate;
+                else if (materialBinding == SoMaterialBindingElement::PER_FACE) material = face;
+                if ((normals && (normal < 0 || normal >= normalCount))
+                    || material < 0 || material >= materialCount) {
+                    fail("SoFCIndexedFaceSet: invalid reduced normal or material index"); return;
+                }
+                points.push_back({coordinate, normal, material});
+            }
+        }
+        SoPrimitiveVertex vertex;
+        SoPointDetail detail;
+        vertex.setDetail(&detail);
+        vertex.setTextureCoords(0.0F, 0.0F);
+        beginShape(action, POINTS);
+        for (const auto& point : points) {
+            vertex.setPoint(coords->get3(point.coordinate));
+            vertex.setNormal(normals ? normals[point.normal] : SbVec3f(0, 0, 1));
+            vertex.setMaterialIndex(point.material);
+            detail.setCoordinateIndex(point.coordinate);
+            detail.setNormalIndex(point.normal);
+            detail.setMaterialIndex(point.material);
+            shapeVertex(&vertex);
+        }
+        endShape();
+        return;
+    }
+#endif
+    inherited::generatePrimitives(action);
+}
