+void SoFCControlPoints::callback(SoCallbackAction* action)
+{
+    if (!action || !renderRoot) return;
+    if (numPolesU.getValue()==0 && numPolesV.getValue()==0
+        && numKnotsU.getValue()==0 && numKnotsV.getValue()==0) return;
+    const uint64_t polesU=numPolesU.getValue(), polesV=numPolesV.getValue();
+    const uint64_t knotsU=numKnotsU.getValue(), knotsV=numKnotsV.getValue();
+    const uint64_t poles=polesU*polesV, knots=knotsU*knotsV;
+    const auto* coordinates=SoCoordinateElement::getInstance(action->getState());
+    if ((polesU==0)!=(polesV==0) || (knotsU==0)!=(knotsV==0)
+        || poles>65536 || knots>65536 || poles+knots>65536
+        || poles+knots>static_cast<uint64_t>(coordinates->getNum())) {
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+        if (action->isOfType(CoinRenderAction::getClassTypeId()))
+            static_cast<CoinRenderAction*>(action)->rejectUnsupported("SoFCControlPoints: invalid dimensions, coordinate range or 65536-point budget");
+#endif
+        return;
+    }
+    if (!syncRenderGeometry(action->getState())) {
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+        if (action->isOfType(CoinRenderAction::getClassTypeId()))
+            static_cast<CoinRenderAction*>(action)->rejectUnsupported("SoFCControlPoints: coordinates do not cover poles/knots");
+#endif
+        return;
+    }
+    renderRoot->callback(action);
+}
