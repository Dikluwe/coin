@@ -0,0 +1,37 @@
+// Generated GUI RGBA images have an explicit portable texture payload.
+// The logical drawing quad is unchanged; GL and CoinRender see identical bytes.
+#ifndef FREECAD_COIN_RENDER_GENERATED_IMAGE_H
+#define FREECAD_COIN_RENDER_GENERATED_IMAGE_H
+#include <Inventor/fields/SoSFImage.h>
+#include <QImage>
+#include <cstddef>
+namespace Gui {
+inline void setGeneratedTextureImage(SoSFImage& output, const SbVec2s& size,
+                                     int components, const unsigned char* pixels)
+{
+    SbVec2s textureSize = size;
+    QImage resampled;
+    auto nextPowerOfTwo = [](int value) {
+        int result = 1;
+        while (result < value) result *= 2;
+        return result;
+    };
+    const int width = nextPowerOfTwo(size[0]);
+    const int height = nextPowerOfTwo(size[1]);
+    if (pixels && size[0] > 0 && size[1] > 0 && components == 4
+        && width <= 8192 && height <= 8192
+        && static_cast<size_t>(width) * height * 4 <= 16 * 1024 * 1024
+        && (width != size[0] || height != size[1])) {
+        QImage source(pixels, size[0], size[1], size[0]*4, QImage::Format_RGBA8888);
+        resampled = source.convertToFormat(QImage::Format_RGBA8888_Premultiplied)
+                        .scaled(width,height,Qt::IgnoreAspectRatio,Qt::SmoothTransformation)
+                        .convertToFormat(QImage::Format_RGBA8888);
+        if (!resampled.isNull()) {
+            textureSize.setValue(width,height);
+            pixels = resampled.constBits();
+        }
+    }
+    output.setValue(textureSize,components,pixels,SoSFImage::COPY);
+}
+}
+#endif
