+void SoFCBoundingBox::callback(SoCallbackAction* action)
+{
+    if (!action) return;
+    SoState* state = action->getState();
+    prepareGeometry(state);
+    state->push();
+    if (ViewParams::instance()->getRenderProjectedBBox())
+        SoModelMatrixElement::makeIdentity(state, this);
+    const SbMatrix transform = SoModelMatrixElement::get(state)
+        * SoViewingMatrixElement::get(state) * SoProjectionMatrixElement::get(state);
+    for(int i=0;i<8;++i) {
+        const auto& point=bboxCoords->point[i];
+        SbVec4f clip(point[0],point[1],point[2],1);
+        transform.multVecMatrix(clip,clip);
+        if (!std::isfinite(clip[2]) || !std::isfinite(clip[3]) || clip[3]<=0
+            || clip[2]<-clip[3] || clip[2]>clip[3]) {
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+            if (action->isOfType(CoinRenderAction::getClassTypeId()))
+                static_cast<CoinRenderAction*>(action)->rejectUnsupported("SoFCBoundingBox: geometric depth clamp is outside the portable profile");
+#endif
+            state->pop();
+            return;
+        }
+    }
+    SoLazyElement::setLightModel(state, SoLazyElement::BASE_COLOR);
+    const SbBool test=SoDepthBufferElement::getTestEnable(state);
+    const SbBool write=SoDepthBufferElement::getWriteEnable(state);
+    const auto range=SoDepthBufferElement::getRange(state);
+    SoDepthBufferElement::set(state,test,write,SoDepthBufferElement::LEQUAL,range);
+    bboxSep->callback(action);
+    SoDepthBufferElement::set(state,test,write,SoDepthBufferElement::ALWAYS,range);
+    if(coordsOn.getValue()) textSep->callback(action);
+    if(dimensionsOn.getValue()) dimSep->callback(action);
+    state->pop();
 }

