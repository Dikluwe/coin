+void SoPolygon::callback(SoCallbackAction* action)
+{
+    if (!render.getValue()) return;
+    const auto* coordinates = SoCoordinateElement::getInstance(action->getState());
+    const int32_t first = startIndex.getValue(), count = numVertices.getValue();
+    if (first < 0 || count < 0 || count > 65536 || first > coordinates->getNum()
+        || count > coordinates->getNum() - first) {
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+        if (action->isOfType(CoinRenderAction::getClassTypeId()))
+            static_cast<CoinRenderAction*>(action)->rejectUnsupported("SoPolygon: invalid coordinate range or 65536-point budget");
+#endif
+        return;
+    }
+    if (count < 2) return;
+    auto* root = new SoSeparator; root->ref();
+    auto* lighting = new SoLightModel; lighting->model = SoLightModel::BASE_COLOR;
+    root->addChild(lighting);
+    auto* style = new SoDrawStyle; style->lineWidth = 3.0F;
+    root->addChild(style);
+    auto* points = new SoCoordinate3;
+    auto* lines = new SoLineSet;
+    for (int32_t i = 0; i < count; ++i) {
+        points->point.set1Value(2*i, coordinates->get3(first+i));
+        points->point.set1Value(2*i+1, coordinates->get3(first+(i+1)%count));
+        lines->numVertices.set1Value(i, 2);
+    }
+    root->addChild(points); root->addChild(lines);
+    root->callback(action);
+    root->unref();
+}
+
+void SoPolygon::generatePrimitives(SoAction* action)
+{
+    if (!render.getValue()) return;
+    SoState* state = action->getState();
+    const auto* coordinates = SoCoordinateElement::getInstance(state);
+    const int32_t first = startIndex.getValue(), count = numVertices.getValue();
+    if (first < 0 || count < 0 || count > 65536 || first > coordinates->getNum()
+        || count > coordinates->getNum() - first) {
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+        if (action->isOfType(CoinRenderAction::getClassTypeId()))
+            static_cast<CoinRenderAction*>(action)->rejectUnsupported("SoPolygon: invalid coordinate range or 65536-point budget");
+#endif
+        return;
+    }
+    if (count < 2) return;
+    state->push();
+    SoLazyElement::setLightModel(state, SoLazyElement::BASE_COLOR);
+    SoLineWidthElement::set(state, 3.0F);
+    SoPrimitiveVertex vertex;
+    vertex.setNormal(SbVec3f(0,0,1));
+    vertex.setMaterialIndex(0);
+    beginShape(action, SoShape::LINES);
+    for (int32_t i = 0; i < count; ++i) {
+        vertex.setPoint(coordinates->get3(first+i)); shapeVertex(&vertex);
+        vertex.setPoint(coordinates->get3(first+(i+1)%count)); shapeVertex(&vertex);
+    }
+    endShape();
+    state->pop();
+}

