+void SoFCMeshGridNode::callback(SoCallbackAction* action)
+{
+    const SbVec3s dimensions = lenGrid.getValue();
+    if (dimensions == SbVec3s(0,0,0)) return; // Unconfigured grid.
+    for (int axis=0; axis<3; ++axis) {
+        if (dimensions[axis] < 1 || dimensions[axis] > 128) {
+#ifdef FREECAD_COIN_WGPU_EXPERIMENTAL
+            if (action->isOfType(CoinRenderAction::getClassTypeId()))
+                static_cast<CoinRenderAction*>(action)->rejectUnsupported("SoFCMeshGridNode: divisions must be 1..128");
+#endif
+            return;
+        }
+    }
+    auto* scene = new SoSeparator; scene->ref();
+    auto* lighting = new SoLightModel; lighting->model = SoLightModel::BASE_COLOR; scene->addChild(lighting);
+    auto* color = new SoBaseColor; color->rgb.setValue(0,1,0); scene->addChild(color);
+    auto* coordinates = new SoCoordinate3; scene->addChild(coordinates);
+    std::vector<SbVec3f> points;
+    const auto minimum=minGrid.getValue(), maximum=maxGrid.getValue();
+    for (int axis=0; axis<3; ++axis) {
+        const int a=(axis+1)%3, b=(axis+2)%3;
+        for(int i=0;i<=dimensions[a];++i) for(int j=0;j<=dimensions[b];++j) {
+            SbVec3f start=minimum, end;
+            start[a] += (maximum[a]-minimum[a])*float(i)/dimensions[a];
+            start[b] += (maximum[b]-minimum[b])*float(j)/dimensions[b];
+            end=start; end[axis]=maximum[axis];
+            points.push_back(start); points.push_back(end);
+        }
+    }
+    coordinates->point.setValues(0,static_cast<int>(points.size()),points.data());
+    auto* lines = new SoLineSet; scene->addChild(lines);
+    std::vector<int32_t> counts(points.size()/2,2);
+    lines->numVertices.setValues(0,static_cast<int>(counts.size()),counts.data());
+    scene->callback(action);
+    scene->unref();
 }

