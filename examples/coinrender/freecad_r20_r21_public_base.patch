+GLGraphicsItem& GLGraphicsItem::operator=(const GLGraphicsItem& other)
+{
+    if (this != &other) {
+        Base::BaseClass::operator=(other);
+        if (overlayRoot) overlayRoot->unref();
+        overlayRoot = nullptr;
+        overlayDirty = true;
+    }
+    return *this;
+}
+
+SoNode* GLGraphicsItem::overlayScene(int width, int height)
+{
+    if (overlayDirty || width != overlayWidth || height != overlayHeight) {
+        SoNode* next = buildOverlayScene(width, height); // Returns one owned reference.
+        if (overlayRoot) overlayRoot->unref();
+        overlayRoot = next;
+        overlayWidth = width;
+        overlayHeight = height;
+        overlayDirty = false;
+    }
+    return overlayRoot;
