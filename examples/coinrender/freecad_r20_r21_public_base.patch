+    SelContextPtr ctx = Gui::SoFCSelectionRoot::getActionContext(
+        action, this, selContext, false);
+    SelContextPtr ctx2 = Gui::SoFCSelectionRoot::getSecondaryActionContext<SelContext>(action, this);
+    if (selContext2->checkGlobal(ctx)) {
+        ctx = selContext2;
+    }
+    if (ctx && ctx->selectionIndex.empty() && ctx->highlightIndex < 0) {
+        ctx.reset();
+    }
+
+    SoState* state = action->getState();
+    const bool pushed = overrideMaterialBinding(action, ctx, ctx2);
+    inherited::callback(action);
+    if (pushed) {
+        state->pop();
+    }
+}
