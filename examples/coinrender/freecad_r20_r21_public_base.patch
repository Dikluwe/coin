+SoNode* GLFlagWindow::overlayScene(int width, int height)
+{
+    std::vector<int> coordinates;
+    if (_flagLayout && width > 0 && height > 0 &&
+        _viewer->getSoRenderManager()->getCamera()) {
+        const auto volume = _viewer->getSoRenderManager()->getCamera()->getViewVolume(
+            static_cast<float>(width) / height);
+        const qreal dpr = _viewer->devicePixelRatioF();
+        for (int i = 0; i < _flagLayout->count(); ++i) {
+            auto* flag = qobject_cast<Flag*>(_flagLayout->itemAt(i)->widget());
+            if (!flag || !flag->isVisible()) continue;
+            SbVec3f projected;
+            volume.projectToScreen(flag->getOrigin(), projected);
+            const QPoint anchor = _viewer->viewport()->mapFromGlobal(
+                flag->mapToGlobal(QPoint(0, flag->height()/2)));
+            coordinates.insert(coordinates.end(), {
+                static_cast<int>(anchor.x()*dpr), static_cast<int>(anchor.y()*dpr),
+                static_cast<int>(projected[0]*width),
+                static_cast<int>((1.0f-projected[1])*height)});
+        }
+    }
+    if (coordinates != overlayCoordinates) {
+        overlayCoordinates = std::move(coordinates);
+        invalidateOverlayScene();
+    }
+    return GLGraphicsItem::overlayScene(width, height);
+}
+
+SoNode* GLFlagWindow::buildOverlayScene(int width, int height)
+{
+    if (overlayCoordinates.empty()) return nullptr;
+    auto* scene = new SoSeparator;
+    scene->ref();
+    GLPainter painter;
+    if (!painter.begin(scene, width, height)) {
+        scene->unref();
+        return nullptr;
+    }
+    for (size_t i = 0; i < overlayCoordinates.size(); i += 4) {
+        painter.setLineWidth(1.0f);
+        painter.drawLine(overlayCoordinates[i], overlayCoordinates[i+1],
+                         overlayCoordinates[i+2], overlayCoordinates[i+3]);
+        painter.setPointSize(3.0f);
+        painter.drawPoint(overlayCoordinates[i+2], overlayCoordinates[i+3]);
+    }
+    painter.end();
+    return scene;
+}
+
