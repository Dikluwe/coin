+    SoNode* mainScene = getSoRenderManager() ? getSoRenderManager()->getSceneGraph() : nullptr;
+    const bool live = shouldRenderDecorations(currentRenderIntent());
+    auto* viewer = const_cast<View3DInventorViewer*>(this);
+    SbViewportRegion axisViewport;
+    const bool axes = live && axiscrossEnabled && viewer->prepareAxisCross(axisViewport);
+    if (axes && wgpuAxisCrossRoot->getNumChildren() == 1) {
+        wgpuAxisCrossRoot->addChild(axisCrossSceneState->axisRoot);
+        wgpuAxisCrossRoot->addChild(axisCrossSceneState->lettersRoot);
+    }
+    if (live && rubberbandOverlayRenderer) {
+        rubberbandOverlayRenderer->prepareGeometry(
+            getSoRenderManager()->getViewportRegion(), devicePixelRatio());
+    }
+    std::vector<SoNode*> itemScenes;
+    if (live) {
+        const auto size = getSoRenderManager()->getViewportRegion().getViewportSizePixels();
+        for (auto* item : graphicsItems) {
+            if (SoNode* scene = item->overlayScene(size[0], size[1])) itemScenes.push_back(scene);
+        }
+    }
+    bool graphicsChanged = wgpuGraphicsRoot->getNumChildren() != static_cast<int>(itemScenes.size());
+    for (size_t i = 0; !graphicsChanged && i < itemScenes.size(); ++i) {
+        graphicsChanged = wgpuGraphicsRoot->getChild(static_cast<int>(i)) != itemScenes[i];
+    }
+    if (graphicsChanged) {
+        wgpuGraphicsRoot->removeAllChildren();
+        for (auto* scene : itemScenes) wgpuGraphicsRoot->addChild(scene);
+    }
+    const int children = 2 + (live ? 3 : 0) + (axes ? 1 : 0);
+    if (mainScene && (wgpuSceneRoot->getNumChildren() != children
+                      || wgpuSceneRoot->getChild(0) != mainScene)) {
+        wgpuSceneRoot->removeAllChildren();
+        wgpuSceneRoot->addChild(mainScene);
+        wgpuSceneRoot->addChild(wgpuForeground(foregroundroot));
