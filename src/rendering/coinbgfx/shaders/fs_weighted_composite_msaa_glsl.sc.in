$input v_coinClipDepth, v_color0, v_ambient, v_specular, v_emission, v_texcoord0, v_viewPosition, v_viewNormal, v_material, v_texcoords4, v_texcoords5, v_texcoords6, v_texcoords7, v_textureQ0, v_textureQ1
#version 430
#extension GL_ARB_shader_texture_image_samples : require
layout(binding = 0) uniform sampler2DMS s_oitAccumMS;
layout(binding = 1) uniform sampler2DMS s_oitRevealMS;
uniform vec4 u_depthInfo;
layout(location = 0) out vec4 coinWeightedOutput;
#define gl_FragColor coinWeightedOutput
ivec2 coinWeightedCounts()
{
  return ivec2(textureSamples(s_oitAccumMS), textureSamples(s_oitRevealMS));
}
@COIN_BGFX_WEIGHTED_FORMULA@
@COIN_BGFX_WEIGHTED_MSAA@
