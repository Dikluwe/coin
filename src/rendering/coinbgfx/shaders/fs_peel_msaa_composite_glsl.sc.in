$input v_coinClipDepth, v_color0, v_ambient, v_specular, v_emission, v_texcoord0, v_viewPosition, v_viewNormal, v_material, v_texcoords4, v_texcoords5, v_texcoords6, v_texcoords7, v_textureQ0, v_textureQ1
#version 430
#extension GL_ARB_shader_texture_image_samples : require
layout(binding = 0) uniform sampler2DMS s_peelColorMS;
layout(binding = 1) uniform sampler2DMS s_peelMaskMS;
layout(binding = 2) uniform sampler2DMS s_peelDepthMS;
uniform vec4 u_depthInfo;
layout(location = 0) out vec4 coinPeelOutput;
#define gl_FragColor coinPeelOutput
#define COIN_PEEL_SHADER_MASK 1
ivec3 coinPeelCounts()
{
  return ivec3(textureSamples(s_peelColorMS), textureSamples(s_peelMaskMS), textureSamples(s_peelDepthMS));
}
@COIN_BGFX_PEEL_MSAA_COMPOSITE@
