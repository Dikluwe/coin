$input v_coinClipDepth, v_color0, v_ambient, v_specular, v_emission, v_texcoord0, v_viewPosition, v_viewNormal, v_material, v_texcoords4, v_texcoords5, v_texcoords6, v_texcoords7, v_textureQ0, v_textureQ1
#version 430
#extension GL_ARB_shader_texture_image_samples : require

// Native GLSL is packaged with shaderc --raw: its preprocessor otherwise
// removes #extension and cannot compile this exact sample-count query.
layout(binding = 0) uniform sampler2DMS s_msaaColor;
layout(binding = 1) uniform sampler2DMS s_msaaDepth;
uniform vec4 u_depthInfo;
layout(location = 0) out vec4 coinMsaaOutput;
#define gl_FragColor coinMsaaOutput

ivec2 coinMsaaCounts()
{
    return ivec2(textureSamples(s_msaaColor), textureSamples(s_msaaDepth));
}

@COIN_BGFX_MSAA_BODY@
